# Copia este archivo a .env si quieres usar python/pytest fuera de Docker.
# Con Docker Compose, MONGO_URL ya viene del docker-compose.yml.

MONGO_URL=mongodb://localhost:27017
MONGO_DB=turisconecta

# Cambia esta clave por una larga y aleatoria antes de desplegar.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=120

# Supuestos del indicador de impacto (proporciones sobre el precio final).
COMISION_PLATAFORMA=0.05
COMISION_AGENCIA=0.30

# Orígenes permitidos para el frontend (separados por coma).
CORS_ORIGINS=http://localhost:5173
